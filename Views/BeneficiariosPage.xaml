<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:InternetBankingApp.Models"
             xmlns:vm="clr-namespace:InternetBankingApp.ViewModels"
             x:Class="InternetBankingApp.Views.BeneficiariosPage"
             x:Name="PageRoot"
             x:DataType="vm:BeneficiariosViewModel"
             Title="Beneficiarios">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Button Text="{Binding ToggleButtonText}"
                    HorizontalOptions="Fill"
                    Command="{Binding ToggleFormCommand}" />

            <Border IsVisible="{Binding IsFormVisible}"
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource Gray200}"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding FormTitle}" TextColor="{StaticResource MidnightBlue}" FontFamily="OpenSansSemibold" FontSize="17" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre" TextColor="{StaticResource Gray500}" FontSize="13" />
                        <Entry Text="{Binding Nombre}" Placeholder="Ej. Juan Pérez" />
                        <Label Text="{Binding NombreError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="{Binding NombreError, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Número de cuenta" TextColor="{StaticResource Gray500}" FontSize="13" />
                        <Entry Text="{Binding NumeroCuenta}" Placeholder="Ej. 2002345678" Keyboard="Numeric" />
                        <Label Text="{Binding NumeroCuentaError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="{Binding NumeroCuentaError, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Banco" TextColor="{StaticResource Gray500}" FontSize="13" />
                        <Entry Text="{Binding Banco}" Placeholder="Ej. Banco Nacional" />
                        <Label Text="{Binding BancoError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="{Binding BancoError, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <Button Text="{Binding GuardarButtonText}" Command="{Binding GuardarCommand}" />

                    <Button Text="Eliminar beneficiario"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding EliminarCommand}"
                            CommandParameter="{Binding BeneficiarioEnEdicion}"
                            IsVisible="{Binding IsEditMode}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Beneficiarios registrados" TextColor="{StaticResource MidnightBlue}" FontFamily="OpenSansSemibold" FontSize="17" />

            <CollectionView ItemsSource="{Binding Beneficiarios}">
                <CollectionView.EmptyView>
                    <Label Text="No hay beneficiarios registrados aún." TextColor="{StaticResource Gray400}" HorizontalOptions="Center" Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Beneficiario">
                        <Border Stroke="{StaticResource Gray200}" BackgroundColor="{StaticResource White}" Margin="0,0,0,10" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.EditarCommand, Source={x:Reference PageRoot}}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nombre}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource MidnightBlue}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Banco}" TextColor="{StaticResource EmeraldDark}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding NumeroCuenta, StringFormat='Cuenta: {0}'}" TextColor="{StaticResource Gray500}" FontSize="13" />
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                        Style="{StaticResource DeleteIconButtonStyle}"
                                        VerticalOptions="Center"
                                        Margin="10,0,0,0"
                                        Command="{Binding BindingContext.EliminarCommand, Source={x:Reference PageRoot}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
