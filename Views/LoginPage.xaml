<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InternetBankingApp.ViewModels"
             x:Class="InternetBankingApp.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Bienvenido"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Primary}">

    <Grid RowDefinitions="Auto,*">

        <!-- Encabezado de marca: azul base con acento esmeralda -->
        <VerticalStackLayout Grid.Row="0"
                             BackgroundColor="{StaticResource Primary}"
                             Padding="30,70,30,50"
                             Spacing="10">

            <Image Source="logo.png"
                   HeightRequest="88"
                   WidthRequest="88"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,0,0,6"/>

            <Label Text="Internet Banking"
                   TextColor="{StaticResource White}"
                   FontFamily="OpenSansSemibold"
                   FontSize="26"
                   HorizontalOptions="Center"/>

            <Label Text="Tu patrimonio, siempre en crecimiento"
                   TextColor="{StaticResource EmeraldLight}"
                   FontSize="14"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Tarjeta de acceso -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource White}"
                Stroke="Transparent"
                Margin="20,-30,20,20"
                Padding="25,35"
                VerticalOptions="Start">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource Tertiary}"
                        Opacity="0.18"
                        Radius="20"
                        Offset="0,8"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">

                <Label Text="Iniciar sesión"
                       TextColor="{StaticResource MidnightBlue}"
                       FontFamily="OpenSansSemibold"
                       FontSize="20"/>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Usuario"
                            TextColor="{StaticResource Gray500}"
                            FontSize="13"/>
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeThickness="1"
                            Padding="14,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding Usuario}"
                               Placeholder="Ingresa tu usuario"
                               PlaceholderColor="{StaticResource Gray300}"/>
                    </Border>
                    <Label Text="{Binding UsuarioError}"
                           TextColor="{StaticResource Danger}"
                           FontSize="12"
                           IsVisible="{Binding UsuarioError, Converter={StaticResource StringNotEmptyConverter}}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Contraseña"
                            TextColor="{StaticResource Gray500}"
                            FontSize="13"/>
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeThickness="1"
                            Padding="14,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding Contrasena}"
                               Placeholder="Ingresa tu contraseña"
                               PlaceholderColor="{StaticResource Gray300}"
                               IsPassword="True"/>
                    </Border>
                    <Label Text="{Binding ContrasenaError}"
                           TextColor="{StaticResource Danger}"
                           FontSize="12"
                           IsVisible="{Binding ContrasenaError, Converter={StaticResource StringNotEmptyConverter}}"/>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMensaje}"
                       TextColor="{StaticResource Danger}"
                       FontSize="13"
                       IsVisible="{Binding ErrorMensaje, Converter={StaticResource StringNotEmptyConverter}}"/>

                <Button Text="Iniciar Sesión"
                        HorizontalOptions="Fill"
                        Margin="0,10,0,0"
                        Command="{Binding IniciarSesionCommand}"/>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
