<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:InternetBankingApp.Models"
             xmlns:controls="clr-namespace:InternetBankingApp.Controls"
             xmlns:vm="clr-namespace:InternetBankingApp.ViewModels"
             x:Class="InternetBankingApp.Views.PrestamosPage"
             x:Name="PageRoot"
             x:DataType="vm:PrestamosViewModel"
             Title="Préstamos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Button Text="{Binding ToggleButtonText}"
                    HorizontalOptions="Fill"
                    Command="{Binding ToggleFormCommand}" />

            <Border IsVisible="{Binding IsFormVisible}"
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource Gray200}"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                    <Label Text="{Binding FormTitle}" TextColor="{StaticResource MidnightBlue}" FontFamily="OpenSansSemibold" FontSize="17" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Producto" TextColor="{StaticResource Gray500}" FontSize="13" />
                        <Entry Text="{Binding Producto}" Placeholder="Ej. Préstamo personal" />
                        <Label Text="{Binding ProductoError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="{Binding ProductoError, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Monto solicitado" TextColor="{StaticResource Gray500}" FontSize="13" />
                        <Entry Text="{Binding Monto}" Placeholder="0.00" Keyboard="Numeric" />
                        <Label Text="{Binding MontoError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="{Binding MontoError, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Plazo (meses)" TextColor="{StaticResource Gray500}" FontSize="13" />
                        <Entry Text="{Binding Plazo}" Placeholder="Ej. 24" Keyboard="Numeric" />
                        <Label Text="{Binding PlazoError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="{Binding PlazoError, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <Button Text="{Binding GuardarButtonText}"
                            Command="{Binding GuardarCommand}"
                            IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                    <Button Text="Eliminar préstamo"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding EliminarCommand}"
                            CommandParameter="{Binding PrestamoEnEdicion}"
                            IsVisible="{Binding IsEditMode}" />

                    <VerticalStackLayout IsVisible="{Binding IsBusy}" Spacing="8" Margin="0,4,0,0">
                        <controls:LoadingDots x:Name="LoadingIndicator" HeightRequest="20" />
                        <Label Text="Esperando autorización del banco..." TextColor="{StaticResource Gray500}" FontSize="13" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Préstamos aprobados" TextColor="{StaticResource MidnightBlue}" FontFamily="OpenSansSemibold" FontSize="17" />

            <CollectionView ItemsSource="{Binding Prestamos}">
                <CollectionView.EmptyView>
                    <Label Text="No hay préstamos aprobados aún." TextColor="{StaticResource Gray400}" HorizontalOptions="Center" Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Prestamo">
                        <Border Stroke="{StaticResource Gray200}" Margin="0,0,0,10" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.EditarCommand, Source={x:Reference PageRoot}}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Producto}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource MidnightBlue}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding PlazoMeses, StringFormat='{0} meses'}" TextColor="{StaticResource EmeraldDark}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding MontoSolicitado, StringFormat='Monto: {0:C2}'}" TextColor="{StaticResource Gray500}" FontSize="13" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding FechaSolicitud, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{StaticResource Gray400}" FontSize="13" />
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                        Style="{StaticResource DeleteIconButtonStyle}"
                                        VerticalOptions="Center"
                                        Margin="10,0,0,0"
                                        Command="{Binding BindingContext.EliminarCommand, Source={x:Reference PageRoot}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
