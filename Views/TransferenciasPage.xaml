<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:InternetBankingApp.Models"
             xmlns:vm="clr-namespace:InternetBankingApp.ViewModels"
             x:Class="InternetBankingApp.Views.TransferenciasPage"
             x:DataType="vm:TransferenciasViewModel"
             Title="Transferencias">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Necesitas al menos una cuenta y un beneficiario registrados para poder transferir."
                   TextColor="{StaticResource Danger}"
                   FontSize="13"
                   IsVisible="{Binding RequisitoVisible}" />

            <Button Text="{Binding ToggleButtonText}"
                    HorizontalOptions="Fill"
                    IsEnabled="{Binding PuedeTransferir}"
                    Command="{Binding ToggleFormCommand}" />

            <Border IsVisible="{Binding IsFormVisible}"
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource Gray200}"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Nueva transferencia" TextColor="{StaticResource MidnightBlue}" FontFamily="OpenSansSemibold" FontSize="17" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Cuenta origen" TextColor="{StaticResource Gray500}" FontSize="13" />
                        <Picker x:Name="CuentaPicker" Title="Selecciona una cuenta"
                                ItemsSource="{Binding Cuentas}"
                                SelectedItem="{Binding CuentaOrigenSeleccionada}" />
                        <Label Text="{Binding CuentaOrigenError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="{Binding CuentaOrigenError, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Beneficiario destino" TextColor="{StaticResource Gray500}" FontSize="13" />
                        <Picker x:Name="BeneficiarioPicker" Title="Selecciona un beneficiario"
                                ItemsSource="{Binding Beneficiarios}"
                                SelectedItem="{Binding BeneficiarioDestinoSeleccionado}" />
                        <Label Text="{Binding BeneficiarioDestinoError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="{Binding BeneficiarioDestinoError, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Concepto" TextColor="{StaticResource Gray500}" FontSize="13" />
                        <Entry Text="{Binding Concepto}" Placeholder="Ej. Pago de servicios" />
                        <Label Text="{Binding ConceptoError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="{Binding ConceptoError, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Monto" TextColor="{StaticResource Gray500}" FontSize="13" />
                        <Entry Text="{Binding Monto}" Placeholder="0.00" Keyboard="Numeric" />
                        <Label Text="{Binding MontoError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="{Binding MontoError, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <Button Text="Transferir" Command="{Binding GuardarCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Transferencias registradas" TextColor="{StaticResource MidnightBlue}" FontFamily="OpenSansSemibold" FontSize="17" />

            <CollectionView ItemsSource="{Binding Transferencias}">
                <CollectionView.EmptyView>
                    <Label Text="No hay transferencias registradas aún." TextColor="{StaticResource Gray400}" HorizontalOptions="Center" Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Transferencia">
                        <Border Stroke="{StaticResource Gray200}" Margin="0,0,0,10" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Concepto}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource MidnightBlue}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Monto, StringFormat='{0:C2}'}" TextColor="{StaticResource EmeraldDark}" FontFamily="OpenSansSemibold" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding CuentaOrigen, StringFormat='Desde cuenta: {0}'}" TextColor="{StaticResource Gray500}" FontSize="13" />
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding BeneficiarioDestino, StringFormat='Para: {0}'}" TextColor="{StaticResource Gray500}" FontSize="13" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{StaticResource Gray400}" FontSize="13" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
